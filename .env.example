# Copy to .env and fill in. Never commit .env.
QDRANT_URL=
QDRANT_API_KEY=
GOOGLE_API_KEY=
DATA_ROOT=/path/to/capstone-data-toolkit/data/plantguard
LLM_MODEL=gemini/gemini-3.5-flash

# M7: optional. Tracing degrades to a no-op (one warning, no crash) if unset.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
